{
  "name": "wuliaotong-frontend",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w wlt-desktop",
    "dev:mobile": "npm run dev -w wlt-mobile",
    "build": "npm run build -w wlt-desktop && npm run build -w wlt-mobile",
    "typecheck": "tsc --noEmit -p apps/desktop && tsc --noEmit -p apps/mobile"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
